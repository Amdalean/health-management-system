<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hms.main.teacher.mapper.HmsTeacherMapper">

    <resultMap type="HmsTeacher" id="HmsTeacherResult">
        <id     property="teacherId"  column="teacher_id"  />
        <result property="staffNo"    column="staff_no"    />
        <result property="name"       column="name"        />
        <result property="gender"     column="gender"      />
        <result property="title"      column="title"       />
        <result property="phone"      column="phone"       />
        <result property="hireDate"   column="hire_date"   />
        <result property="department" column="department"  />
        <result property="userId"     column="user_id"     />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
    </resultMap>

    <sql id="selectHmsTeacherVo">
        select teacher_id, staff_no, name, gender, title, phone, hire_date, department,
               user_id, create_by, create_time, update_by, update_time, remark
        from hms_teacher
    </sql>

    <select id="selectHmsTeacherList" parameterType="HmsTeacher" resultMap="HmsTeacherResult">
        <include refid="selectHmsTeacherVo"/>
        <where>
            <if test="staffNo != null and staffNo != ''"> and staff_no like concat('%', #{staffNo}, '%')</if>
            <if test="name != null and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="gender != null and gender != ''"> and gender = #{gender}</if>
            <if test="title != null and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="phone != null and phone != ''"> and phone like concat('%', #{phone}, '%')</if>
            <if test="department != null and department != ''"> and department like concat('%', #{department}, '%')</if>
            <if test="hasAccount != null and hasAccount == 1"> and user_id is not null</if>
            <if test="hasAccount != null and hasAccount == 0"> and user_id is null</if>
        </where>
        order by teacher_id desc
    </select>

    <select id="selectHmsTeacherById" parameterType="Long" resultMap="HmsTeacherResult">
        <include refid="selectHmsTeacherVo"/>
        where teacher_id = #{teacherId}
    </select>

    <select id="selectHmsTeacherByNo" parameterType="String" resultMap="HmsTeacherResult">
        <include refid="selectHmsTeacherVo"/>
        where staff_no = #{staffNo} limit 1
    </select>

    <insert id="insertHmsTeacher" parameterType="HmsTeacher" useGeneratedKeys="true" keyProperty="teacherId">
        insert into hms_teacher
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="staffNo != null and staffNo != ''">staff_no,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="gender != null">gender,</if>
            <if test="title != null">title,</if>
            <if test="phone != null">phone,</if>
            <if test="hireDate != null">hire_date,</if>
            <if test="department != null">department,</if>
            <if test="userId != null">user_id,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="staffNo != null and staffNo != ''">#{staffNo},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="gender != null">#{gender},</if>
            <if test="title != null">#{title},</if>
            <if test="phone != null">#{phone},</if>
            <if test="hireDate != null">#{hireDate},</if>
            <if test="department != null">#{department},</if>
            <if test="userId != null">#{userId},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateHmsTeacher" parameterType="HmsTeacher">
        update hms_teacher
        <trim prefix="SET" suffixOverrides=",">
            <if test="staffNo != null and staffNo != ''">staff_no = #{staffNo},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="title != null">title = #{title},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="hireDate != null">hire_date = #{hireDate},</if>
            <if test="department != null">department = #{department},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where teacher_id = #{teacherId}
    </update>

    <update id="updateTeacherUserId">
        update hms_teacher set user_id = #{userId} where teacher_id = #{teacherId}
    </update>

    <delete id="deleteHmsTeacherById" parameterType="Long">
        delete from hms_teacher where teacher_id = #{teacherId}
    </delete>

    <delete id="deleteHmsTeacherByIds" parameterType="String">
        delete from hms_teacher where teacher_id in
        <foreach item="teacherId" collection="array" open="(" separator="," close=")">
            #{teacherId}
        </foreach>
    </delete>
</mapper>
