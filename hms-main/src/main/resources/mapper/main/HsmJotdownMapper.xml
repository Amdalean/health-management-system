<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hms.main.jotdown.mapper.HsmJotdownMapper">
    
    <resultMap type="HsmJotdown" id="HsmJotdownResult">
        <result property="id"    column="id"    />
        <result property="createBy"    column="create_by"    />
        <result property="personnel"    column="personnel"    />
        <result property="auxiliaryAccounting"    column="auxiliary_accounting"    />
        <result property="description"    column="description"    />
        <result property="amount"    column="amount"    />
        <result property="date"    column="date"    />
        <result property="accountingPeriod"    column="accounting_period"    />
        <result property="expenseType"    column="expense_type"    />
        <result property="remarks"    column="remarks"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
    </resultMap>

    <sql id="selectHsmJotdownVo">
        select t.id, t.create_by, t.personnel, t.auxiliary_accounting, t.description, t.amount, t.date, t.accounting_period, t.expense_type, t.remarks, t.created_at, t.updated_at from hsm_jotdown t
        left join sys_user u on u.user_name = t.create_by
    </sql>

    <select id="selectHsmJotdownList" parameterType="HsmJotdown" resultMap="HsmJotdownResult">
        <include refid="selectHsmJotdownVo"/>
        <where>
            <if test="personnel != null  and personnel != ''"> and t.personnel = #{personnel}</if>
            <if test="auxiliaryAccounting != null  and auxiliaryAccounting != ''"> and t.auxiliary_accounting = #{auxiliaryAccounting}</if>
            <if test="description != null  and description != ''"> and t.description like concat('%', #{description}, '%')</if>
            <if test="amount != null "> and t.amount = #{amount}</if>
            <if test="date != null "> and t.date = #{date}</if>
            <if test="accountingPeriod != null  and accountingPeriod != ''"> and t.accounting_period = #{accountingPeriod}</if>
            <if test="expenseType != null  and expenseType != ''"> and t.expense_type = #{expenseType}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> and t.date &gt;= #{params.beginTime}</if>
            <if test="params.endTime != null and params.endTime != ''"> and t.date &lt;= #{params.endTime}</if>
            ${params.dataScope}
        </where>
        order by t.date desc, t.created_at desc
    </select>
    
    <select id="selectHsmJotdownById" parameterType="Long" resultMap="HsmJotdownResult">
        <include refid="selectHsmJotdownVo"/>
        where t.id = #{id}
    </select>

    <insert id="insertHsmJotdown" parameterType="HsmJotdown" useGeneratedKeys="true" keyProperty="id">
        insert into hsm_jotdown
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="personnel != null and personnel != ''">personnel,</if>
            <if test="auxiliaryAccounting != null and auxiliaryAccounting != ''">auxiliary_accounting,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="amount != null">amount,</if>
            <if test="date != null">date,</if>
            <if test="accountingPeriod != null and accountingPeriod != ''">accounting_period,</if>
            <if test="expenseType != null and expenseType != ''">expense_type,</if>
            <if test="remarks != null">remarks,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="personnel != null and personnel != ''">#{personnel},</if>
            <if test="auxiliaryAccounting != null and auxiliaryAccounting != ''">#{auxiliaryAccounting},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="amount != null">#{amount},</if>
            <if test="date != null">#{date},</if>
            <if test="accountingPeriod != null and accountingPeriod != ''">#{accountingPeriod},</if>
            <if test="expenseType != null and expenseType != ''">#{expenseType},</if>
            <if test="remarks != null">#{remarks},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
         </trim>
    </insert>

    <update id="updateHsmJotdown" parameterType="HsmJotdown">
        update hsm_jotdown
        <trim prefix="SET" suffixOverrides=",">
            <if test="personnel != null and personnel != ''">personnel = #{personnel},</if>
            <if test="auxiliaryAccounting != null and auxiliaryAccounting != ''">auxiliary_accounting = #{auxiliaryAccounting},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="date != null">date = #{date},</if>
            <if test="accountingPeriod != null and accountingPeriod != ''">accounting_period = #{accountingPeriod},</if>
            <if test="expenseType != null and expenseType != ''">expense_type = #{expenseType},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteHsmJotdownById" parameterType="Long">
        delete from hsm_jotdown where id = #{id}
    </delete>

    <delete id="deleteHsmJotdownByIds" parameterType="String">
        delete from hsm_jotdown where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 统一统计：查询总金额和总条数 -->
    <select id="selectJotdownTotalStats" parameterType="HsmJotdown" resultType="java.util.Map">
        select COALESCE(SUM(t.amount), 0) as totalAmount, COUNT(*) as totalCount
        from hsm_jotdown t
        left join sys_user u on u.user_name = t.create_by
        <where>
            <if test="personnel != null  and personnel != ''"> and t.personnel = #{personnel}</if>
            <if test="auxiliaryAccounting != null  and auxiliaryAccounting != ''"> and t.auxiliary_accounting = #{auxiliaryAccounting}</if>
            <if test="description != null  and description != ''"> and t.description like concat('%', #{description}, '%')</if>
            <if test="amount != null "> and t.amount = #{amount}</if>
            <if test="date != null "> and t.date = #{date}</if>
            <if test="accountingPeriod != null  and accountingPeriod != ''"> and t.accounting_period = #{accountingPeriod}</if>
            <if test="expenseType != null  and expenseType != ''"> and t.expense_type = #{expenseType}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> and t.date &gt;= #{params.beginTime}</if>
            <if test="params.endTime != null and params.endTime != ''"> and t.date &lt;= #{params.endTime}</if>
            ${params.dataScope}
        </where>
    </select>

    <!-- 按费用类型分组统计 -->
    <select id="selectJotdownTypeStats" parameterType="HsmJotdown" resultType="java.util.Map">
        select t.expense_type as expenseType, COALESCE(SUM(t.amount), 0) as total
        from hsm_jotdown t
        left join sys_user u on u.user_name = t.create_by
        <where>
            <if test="personnel != null  and personnel != ''"> and t.personnel = #{personnel}</if>
            <if test="auxiliaryAccounting != null  and auxiliaryAccounting != ''"> and t.auxiliary_accounting = #{auxiliaryAccounting}</if>
            <if test="description != null  and description != ''"> and t.description like concat('%', #{description}, '%')</if>
            <if test="amount != null "> and t.amount = #{amount}</if>
            <if test="date != null "> and t.date = #{date}</if>
            <if test="accountingPeriod != null  and accountingPeriod != ''"> and t.accounting_period = #{accountingPeriod}</if>
            <if test="expenseType != null  and expenseType != ''"> and t.expense_type = #{expenseType}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> and t.date &gt;= #{params.beginTime}</if>
            <if test="params.endTime != null and params.endTime != ''"> and t.date &lt;= #{params.endTime}</if>
            ${params.dataScope}
        </where>
        group by t.expense_type
    </select>
</mapper>