<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hms.main.tbk.mapper.TbkConvertLogMapper">

    <resultMap type="TbkConvertLog" id="TbkConvertLogResult">
        <result property="id"         column="id"          />
        <result property="content"    column="content"     />
        <result property="itemId"     column="item_id"     />
        <result property="title"      column="title"       />
        <result property="provider"   column="provider"    />
        <result property="ip"         column="ip"          />
        <result property="status"     column="status"      />
        <result property="errorMsg"   column="error_msg"   />
        <result property="createTime" column="create_time" />
    </resultMap>

    <insert id="insertTbkConvertLog" parameterType="TbkConvertLog" useGeneratedKeys="true" keyProperty="id">
        insert into tbk_convert_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="content != null">content,</if>
            <if test="itemId != null">item_id,</if>
            <if test="title != null">title,</if>
            <if test="provider != null">provider,</if>
            <if test="ip != null">ip,</if>
            <if test="status != null">status,</if>
            <if test="errorMsg != null">error_msg,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="content != null">#{content},</if>
            <if test="itemId != null">#{itemId},</if>
            <if test="title != null">#{title},</if>
            <if test="provider != null">#{provider},</if>
            <if test="ip != null">#{ip},</if>
            <if test="status != null">#{status},</if>
            <if test="errorMsg != null">#{errorMsg},</if>
            now()
        </trim>
    </insert>

</mapper>
