<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hms.mobile.appversion.mapper.SysAppVersionMapper">

    <resultMap type="com.hms.mobile.appversion.domain.SysAppVersion" id="SysAppVersionResult">
        <id     property="id"           column="id"             />
        <result property="version"      column="version"        />
        <result property="versionCode"  column="version_code"  />
        <result property="platform"     column="platform"      />
        <result property="fileName"     column="file_name"     />
        <result property="filePath"     column="file_path"     />
        <result property="fileSize"     column="file_size"     />
        <result property="forceUpdate" column="force_update"  />
        <result property="releaseNotes" column="release_notes"/>
        <result property="status"      column="status"        />
        <result property="createTime"   column="create_time"  />
        <result property="createBy"     column="create_by"    />
        <result property="updateTime"   column="update_time"  />
        <result property="updateBy"     column="update_by"    />
    </resultMap>

    <sql id="selectAppVersionVo">
        select id, version, version_code, platform, file_name, file_path, file_size,
               force_update, release_notes, status, create_time, create_by, update_time, update_by
        from sys_app_version
    </sql>

    <select id="selectAppVersion" parameterType="com.hms.mobile.appversion.domain.SysAppVersion" resultMap="SysAppVersionResult">
        <include refid="selectAppVersionVo"/>
        <where>
            <if test="version != null and version != ''">
                AND version = #{version}
            </if>
            <if test="platform != null and platform != ''">
                AND platform = #{platform}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectAppVersionById" parameterType="Long" resultMap="SysAppVersionResult">
        <include refid="selectAppVersionVo"/>
        where id = #{id}
    </select>

    <select id="selectLatestAppVersion" parameterType="String" resultMap="SysAppVersionResult">
        <include refid="selectAppVersionVo"/>
        where platform = #{platform} and status = 1
        order by version_code desc
        limit 1
    </select>

    <select id="selectAppVersionList" parameterType="com.hms.mobile.appversion.domain.SysAppVersion" resultMap="SysAppVersionResult">
        <include refid="selectAppVersionVo"/>
        <where>
            <if test="version != null and version != ''">
                AND version like concat('%', #{version}, '%')
            </if>
            <if test="platform != null and platform != ''">
                AND platform = #{platform}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <insert id="insertAppVersion" parameterType="com.hms.mobile.appversion.domain.SysAppVersion" useGeneratedKeys="true" keyProperty="id">
        insert into sys_app_version (
            <if test="version != null and version != ''">version,</if>
            <if test="versionCode != null">version_code,</if>
            <if test="platform != null and platform != ''">platform,</if>
            <if test="fileName != null and fileName != ''">file_name,</if>
            <if test="filePath != null and filePath != ''">file_path,</if>
            <if test="fileSize != null">file_size,</if>
            <if test="forceUpdate != null">force_update,</if>
            <if test="releaseNotes != null">release_notes,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        ) values (
            <if test="version != null and version != ''">#{version},</if>
            <if test="versionCode != null">#{versionCode},</if>
            <if test="platform != null and platform != ''">#{platform},</if>
            <if test="fileName != null and fileName != ''">#{fileName},</if>
            <if test="filePath != null and filePath != ''">#{filePath},</if>
            <if test="fileSize != null">#{fileSize},</if>
            <if test="forceUpdate != null">#{forceUpdate},</if>
            <if test="releaseNotes != null">#{releaseNotes},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateAppVersion" parameterType="com.hms.mobile.appversion.domain.SysAppVersion">
        update sys_app_version
        <set>
            <if test="version != null and version != ''">version = #{version},</if>
            <if test="versionCode != null">version_code = #{versionCode},</if>
            <if test="platform != null and platform != ''">platform = #{platform},</if>
            <if test="fileName != null and fileName != ''">file_name = #{fileName},</if>
            <if test="filePath != null and filePath != ''">file_path = #{filePath},</if>
            <if test="fileSize != null">file_size = #{fileSize},</if>
            <if test="forceUpdate != null">force_update = #{forceUpdate},</if>
            <if test="releaseNotes != null">release_notes = #{releaseNotes},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteAppVersionById" parameterType="Long">
        delete from sys_app_version where id = #{id}
    </delete>

    <delete id="deleteAppVersionByIds" parameterType="Long">
        delete from sys_app_version where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
